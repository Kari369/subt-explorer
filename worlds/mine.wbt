WorldInfo {
  info [ "SubT-style underground exploration: a Summit-XL Steel explores an unknown mine." ]
  title "Underground mine exploration"
  basicTimeStep 32
  randomSeed 0
  contactProperties [
    ContactProperties {
      material1 "InteriorWheelMat"
      coulombFriction [ 0, 2, 0 ]
      frictionRotation -0.785398 0
      bounce 0
      forceDependentSlip [ 10, 0 ]
      softCFM 0.0001
    }
    ContactProperties {
      material1 "ExteriorWheelMat"
      coulombFriction [ 0, 2, 0 ]
      frictionRotation 0.785398 0
      bounce 0
      forceDependentSlip [ 10, 0 ]
      softCFM 0.0001
    }
  ]
}
Viewpoint {
  orientation 0 1 0 0.28
  position 1.3 -4.5 1.75
  near 0.1
  exposure 1.5
  follow "explorer"
  followType "Mounted Shot"
}
Background {
  skyColor [ 0.12 0.1 0.09 ]
  luminosity 0.3
}
Fog {
  color 0.06 0.055 0.05
  fogType "EXPONENTIAL"
  visibilityRange 28
}

